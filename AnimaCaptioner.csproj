<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AnimaCaptioner</RootNamespace>
    <AssemblyName>AnimaCaptioner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 资源管理器 / 任务栏固定项看到的 exe 图标。没有这一行的话，
         exe 会顶着 .NET 的默认图标，而 Assets\app.ico 只被当普通文件拷来拷去。
         （窗口和任务栏的图标是另外的机制：由 AppWindow.SetIcon 在启动时设。） -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <!-- 显式 Platform=x64 时，SDK 默认会在输出路径里插一层平台目录（bin\x64\Release\...）。
         关掉它，让「VS 里按 x64 生成」和「命令行 dotnet build」落在同一个 bin\Release\...：
         否则同一个 exe 有两个位置，从 VS 生成完之后你会发现自己熟悉的那份并没更新。
         中间目录用的是同一个开关（Microsoft.NET.DefaultOutputPaths.targets:113），
         所以输出和中间目录不会错配。 -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 依赖已安装的 .NET 运行时，不打包运行时本体（省 ~70MB）。
         目标机需要 .NET 10 Desktop Runtime。 -->
    <SelfContained>false</SelfContained>
    <!-- 同上：Windows App SDK 也走已安装的运行时（省 ~200MB）。
         目标机需要 Windows App Runtime 1.8+。 -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- 许可：软件本体 GPL-3.0。注意 docs\ 下的随附 Markdown 是 CC BY-NC-SA 4.0
         （非商业），见 docs\LICENSE；标签数据不随本仓库分发。 -->
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright (C) 2026 Blue_Coast</Copyright>
    <Description>Anima 训练集标注工具：按官方大类分段的标签编辑器 + 中文到英文自然语言的翻译器。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- 纯 .NET 的 Markdown 解析器（lib/net10.0，只依赖 System.Memory）。
         帮助页用它把 .md 变成 WinUI 原生控件——刻意不用 WebView2：
         那要拉起整个浏览器渲染栈，滚动和选中都明显迟滞。 -->
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <!-- WinUI3 unpackaged + dotnet publish 的已知缺陷：应用自己的 .pri
       （里面装的是编译后的 XAML）只生成在 bin\，不会被拷进发布目录。
       结果是发布版一碰 XAML 资源就报 "Cannot find a resource with the given key"。
       这里显式补上。（此坑与 DshBroker 同源，直接沿用其修法。） -->
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_AppPriFiles Include="$(TargetDir)*.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_AppPriFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- tests\ 是独立的 net10 测试工程，有自己的 Main。SDK 默认会把
         **\*.cs 全收进来，于是应用工程也会看到那个入口点（CS0017 多个入口点），
         而它的 bin\obj 里还有自动生成的 AssemblyInfo，一并排除掉。 -->
    <Compile Remove="tests\**\*.cs" />
    <!-- tools\ 下是开发用的小工具（图像探针等），各有自己的入口点。
         同理：SDK 默认的 **\*.cs 会把它们也收进来（CS0017 多个入口点）。 -->
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- 种子映射母本：人工整理的「中文概念 → 标签」补充表（273 条），补全量表里
         没有精确中文键的那些常用说法。构建词库时由 VocabBuilder 复制到库旁边，
         所以随程序分发——否则用户建完库还差这一个文件，词库能用但中文会漏一批。
         注意：这只是母本，不构成"随附词库"——没有它词库照样加载，只是少这 273 条映射。 -->
    <Content Include="vocab\seed.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 帮助文档随程序分发：运行时直接读 <exe>\docs 里的 .md，
         所以改文档点「重新载入」即可生效，不必重新编译或重启程序。
         （注意：重新构建会用仓库版本覆盖它——这是刻意的，仓库才是文档的源头。）
         只收顶层：docs\dev\ 是开发文档，不进帮助窗口、也不随程序分发——
         HelpDocs 只枚举 docs 顶层、不递归，这里与它保持一致。 -->
    <Content Include="docs\*.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- 自带文档的许可声明。不带 .md 后缀，所以不会被当成帮助模块加载。 -->
    <Content Include="docs\LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
