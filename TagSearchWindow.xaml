<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AnimaCaptioner.TagSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:AnimaCaptioner.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="标签搜索">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <!-- 两个列表共用同一个行模板：词库结果和"模型查到的标签"长得一样，
                 也应该长得一样——用户在两处做的都是同一件事（看一眼、点 ＋ 加进去）。 -->
            <DataTemplate x:Key="HitTemplate" x:DataType="core:TagHitRow">
                <Grid ColumnSpacing="8" Padding="4,3,4,3" Background="{x:Bind Tint}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="3" CornerRadius="2" Margin="0,1,0,1"
                            Background="{x:Bind Accent}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Tag}" FontFamily="Consolas" FontSize="13"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Cn}" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{x:Bind CnVisibility}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind Meta}" FontSize="10"
                                   HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="已在图中" FontSize="10" HorizontalAlignment="Right"
                                   Visibility="{x:Bind AlreadyVisibility, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="3" Content="＋" Padding="10,2,10,2"
                            VerticalAlignment="Center" Click="Hit_Add_Click"
                            ToolTipService.ToolTip="加入当前图片的标签" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏：模式切换。用两个 RadioButton 而不是 RadioButtons 控件——
             后者在 WinUI 3 里存在但默认单列竖排，横向排要动模板，不值得。 -->
        <Grid Grid.Row="0" Padding="12,10,12,6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="标签搜索" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16"
                        VerticalAlignment="Center">
                <RadioButton x:Name="ModeDb" Content="词库搜索" GroupName="searchmode"
                             Checked="Mode_Checked" />
                <RadioButton x:Name="ModeAi" Content="问模型" GroupName="searchmode"
                             Checked="Mode_Checked"
                             ToolTipService.ToolTip="用自然语言提问，模型去词库里查，再把查到的标签反馈给你" />
            </StackPanel>

            <ProgressRing x:Name="BusyRing" Grid.Column="2" Width="20" Height="20"
                          IsActive="False" Visibility="Collapsed"
                          VerticalAlignment="Center" />
        </Grid>

        <!-- 输入行 -->
        <Grid Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="QueryBox" PlaceholderText="输入中文或英文关键词"
                     TextChanged="Query_TextChanged" KeyDown="Query_KeyDown"
                     FontFamily="Consolas" />
            <Button x:Name="RunBtn" Grid.Column="1" Content="搜索" Padding="18,4,18,4"
                    Click="Run_Click" />
        </Grid>

        <InfoBar x:Name="ErrBar" Grid.Row="2" Margin="12,0,12,8" IsOpen="False"
                 Severity="Error" IsClosable="True" />

        <!-- 主体：两种模式各一个面板，同一时刻只显示一个。
             单击只选中、双击才加入——搜索列表里误触一下就写进训练集太危险。 -->
        <Grid Grid.Row="3" Padding="12,0,12,0">
            <ListView x:Name="HitList" SelectionMode="Single"
                      ItemTemplate="{StaticResource HitTemplate}" />

            <Grid x:Name="AiPane" Visibility="Collapsed" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="6" Padding="12,10,12,10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="AnswerLabel" Text="模型回答" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <RichTextBlock x:Name="AnswerText" IsTextSelectionEnabled="True"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock x:Name="AnswerHint" FontSize="11" TextWrapping="Wrap"
                                       Visibility="Collapsed" Margin="0,4,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="1" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FoundLabel" Text="查到的标签" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <ListView x:Name="AiHitList" Grid.Row="1" SelectionMode="Single"
                              ItemTemplate="{StaticResource HitTemplate}" />
                </Grid>

                <TextBlock x:Name="LogText" Grid.Row="2" FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="12,6,12,10" FontSize="11"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </Grid>
</Window>
