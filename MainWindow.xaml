<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AnimaCaptioner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:AnimaCaptioner.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AnimaCaptioner">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 菜单栏 -->
        <MenuBar Grid.Row="0" x:Name="MainMenu">
            <MenuBarItem Title="文件">
                <MenuFlyoutItem Text="打开训练集…" Click="OpenFolder_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="RecentMenu" Text="最近打开" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="保存" Click="Save_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+S">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="重新载入" Click="Reload_Click"
                                KeyboardAcceleratorTextOverride="F5">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="ExitMenuItem" Text="退出" Click="Exit_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="浏览">
                <MenuFlyoutItem Text="上一张" Click="Prev_Click"
                                KeyboardAcceleratorTextOverride="Alt+←">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="下一张" Click="Next_Click"
                                KeyboardAcceleratorTextOverride="Alt+→">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Right" Modifiers="Menu" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="JumpUnlabeledItem" Text="跳到下一个未标注"
                                Click="JumpUnlabeled_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+→">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Right" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="跳到第一张" Click="JumpFirst_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="预览大图…" Click="Preview_Click"
                                KeyboardAcceleratorTextOverride="空格（列表有焦点时）">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A9;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="视图">
                <MenuFlyoutItem Text="恢复默认布局" Click="ResetLayout_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+0">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number0" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="标签">
                <MenuFlyoutItem Text="上移" Click="TagUp_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+↑">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Up" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="下移" Click="TagDown_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+↓">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Down" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="删除选中" Click="TagDelete_Click"
                                KeyboardAcceleratorTextOverride="Del">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="编辑标签…" Click="TagEditMenu_Click"
                                KeyboardAcceleratorTextOverride="F2">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Edit" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F2" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <!-- Ctrl+C/V 只写 KeyboardAcceleratorTextOverride 作为提示，不在这里挂
                     真的 KeyboardAccelerator：菜单项上的加速键是**窗口级**的，挂上就会
                     把提示词框、中文描述框里的 Ctrl+C/V 一起劫持。真正的绑定挂在
                     TagList 自己的 KeyboardAccelerators 上——那里只在焦点位于标签列表
                     子树内时才触发，机制上就不会冲突。 -->
                <MenuFlyoutItem Text="复制选中标签" Click="TagCopyMenu_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+C">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="粘贴标签" Click="TagPasteMenu_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+V">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Paste" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="翻译 / 规范化选中标签" Click="TagNormalizeMenu_Click">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Refresh" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <!-- 模型补译：只对词库没有中文的标签有意义，所以它和上面那条「规范化」
                     是两件事——前者改标签写法，这条只是补一条中文注释。 -->
                <MenuFlyoutItem Text="模型翻译缺中文的标签" Click="ModelGlossMenu_Click">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Character" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="T" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="添加标签…" Click="AddTagMenu_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="规整大类顺序" Click="SortSections_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+S">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8CB;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="校验整行" Click="TagAudit_Click" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="AppendModeMenuItem" Text="翻译时追加而不是覆盖"
                                      IsChecked="False" Click="AppendModeMenuItem_Click" />
            </MenuBarItem>

            <MenuBarItem Title="工具">
                <MenuFlyoutItem Text="翻译中文描述并追加…" Click="Translate_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+Enter">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C1;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="UndoMenuItem" Text="撤销上次翻译" Click="UndoTranslate_Click"
                                IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="计算标签统计…" Click="ShowStats_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="设置…" Click="Settings_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="打开日志" Click="OpenLog_Click" />
                <MenuFlyoutItem Text="打开程序目录" Click="OpenAppFolder_Click" />
            </MenuBarItem>

            <MenuBarItem Title="帮助">
                <MenuFlyoutItem Text="快捷键与说明" Click="ShowHelp_Click" />
                <MenuFlyoutItem Text="关于" Click="ShowAbout_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- 主体三栏。宽度用 * 比例，分隔条是 Thumb（WinUI 3 没有 WPF 的 GridSplitter）。 -->
        <Grid Grid.Row="1" Padding="12,6,12,0" x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft" Width="2*" MinWidth="200" />
                <ColumnDefinition Width="8" />
                <!-- 中栏 MinWidth=240 是按内容定的：底部「上移 下移 删除 校验」一行
                     实测需要约 226 DIP（按钮内边距收窄到 8,4 之后）。原来写 200 时
                     拖到最窄会把「校验」裁成「校」——即使用户没做错任何事。
                     下限必须同时小于默认中栏的自然宽度（本机 1500x940 @150% 下约
                     251 DIP），否则默认的 2:2:3 布局自己就会被挤变形。 -->
                <ColumnDefinition x:Name="ColMid" Width="2*" MinWidth="240" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="ColRight" Width="3*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- 左：图片列表。单击选中并读取对应 tag，双击开独立预览窗口。 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="2,0,0,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="图片" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="ListCountText" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button Grid.Column="2" x:Name="PreviewBtn" Click="Preview_Click"
                            Padding="6,2" VerticalAlignment="Center"
                            ToolTipService.ToolTip="预览当前图片 (空格)，双击列表项同样可以打开">
                        <FontIcon Glyph="&#xE8A9;" FontSize="12" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <ListView x:Name="ImageList" SelectionMode="Single"
                              SelectionChanged="ImageList_SelectionChanged"
                              DoubleTapped="ImageList_DoubleTapped"
                              ContainerContentChanging="ImageList_ContainerContentChanging"
                              IsItemClickEnabled="False">
                        <!-- 空格键只在列表有焦点时开预览：作为全局快捷键会打断
                             在右侧文本框里打空格。KeyboardAccelerator 挂在控件上，
                             作用域随焦点，正是需要的行为。 -->
                        <ListView.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Space" Invoked="PreviewAccel_Invoked" />
                        </ListView.KeyboardAccelerators>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:ImageItem">
                                <Grid ColumnSpacing="8" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 缩略图。未就绪时露出扩展名，不留空白 -->
                                    <Border Width="44" Height="44" CornerRadius="4"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <TextBlock Text="{x:Bind Ext}" FontSize="10"
                                                       Visibility="{x:Bind ExtVisibility, Mode=OneWay}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                   Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border CornerRadius="3" Padding="4,0"
                                                    Background="{x:Bind BadgeBrush, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind Badge, Mode=OneWay}" FontSize="10"
                                                           Foreground="{x:Bind BadgeTextBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind SubText, Mode=OneWay}" FontSize="10"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <TextBlock Grid.Row="2" x:Name="ListHintText" FontSize="11" Margin="2,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="单击读取 tag，双击预览大图" />
            </Grid>

            <Thumb Grid.Column="1" Style="{StaticResource SplitterThumbStyle}"
                   DragDelta="LeftSplitter_DragDelta"
                   DragCompleted="Splitter_DragCompleted"
                   DoubleTapped="LeftSplitter_DoubleTapped"
                   ToolTipService.ToolTip="拖动调整宽度，双击恢复默认" />

            <!-- 中：tag。按 Anima 官方大类分段，每段一个该类别颜色的框 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="2,0,0,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tag" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="TagCountText" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>

                <!-- 添加标签。AutoSuggestBox 兼作输入框与词库补全：
                     输入中文或英文都会给出候选，回车即加入。 -->
                <Grid Grid.Row="1" Margin="0,0,0,6" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- QueryIcon 用 FontIcon 而不是 SymbolIcon：Symbol 枚举里没有
                         合适的图标，而字形码点已逐条核对存在。
                         KeyDown 只用来接 Tab——Enter 由 QuerySubmitted 走
                         （AutoSuggestBox 自己会把它转成那个事件）。 -->
                    <AutoSuggestBox x:Name="AddTagBox"
                                    PlaceholderText="添加标签：中文或英文（Tab 补全）"
                                    MaxSuggestionListHeight="260"
                                    TextChanged="AddTagBox_TextChanged"
                                    SuggestionChosen="AddTagBox_SuggestionChosen"
                                    QuerySubmitted="AddTagBox_QuerySubmitted"
                                    KeyDown="AddTagBox_KeyDown">
                        <AutoSuggestBox.QueryIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                    <Button Grid.Column="1" x:Name="AddTagBtn" Content="添加"
                            Click="AddTag_Click" Padding="10,4" />
                </Grid>

                <!-- 大类顺序提示。列表按大类分段显示，但文件里的顺序可能不是；
                     不一致时显示这一条，避免"看到的是分好段的、存下去的是另一个顺序"。 -->
                <TextBlock x:Name="SectionOrderHint" Grid.Row="2" FontSize="11"
                           Margin="2,0,0,6" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <Border Grid.Row="3" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <ListView x:Name="TagList" SelectionMode="Extended"
                              CanDragItems="True" AllowDrop="True"
                              DragItemsStarting="TagList_DragItemsStarting"
                              DragOver="TagList_DragOver" Drop="TagList_Drop"
                              RightTapped="TagList_RightTapped"
                              DoubleTapped="TagList_DoubleTapped"
                              PreviewKeyDown="TagList_PreviewKeyDown">
                        <!-- 打字时的按键不能被全局加速键吃掉（Del 会在编辑标签时删掉整个标签）。
                             F2 进编辑、Ctrl+C/V 复制粘贴，都挂在列表上而不是全局：
                             加速键只在焦点位于列表子树内时才触发，所以不会劫持提示词框里
                             自己的 Ctrl+C/Ctrl+V。
                             Esc 不在这里——行内输入框是 AutoSuggestBox，它自己的类处理
                             函数会先把 Esc 吃掉并置 Handled，加速键根本收不到；
                             改成在构造函数里用 AddHandler(handledEventsToo) 接。 -->
                        <ListView.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F2" Invoked="TagEditAccel_Invoked" />
                            <KeyboardAccelerator Key="C" Modifiers="Control"
                                                 Invoked="TagCopyAccel_Invoked" />
                            <KeyboardAccelerator Key="V" Modifiers="Control"
                                                 Invoked="TagPasteAccel_Invoked" />
                            <!-- Ctrl+↑/↓ 也要挂在这里。菜单上的同名加速键在列表有焦点时
                                 **收不到**：ListView 自己把 Ctrl+方向键当成"移动焦点"用掉了
                                 （实测焦点在列表里按 Ctrl+↓，列表滚了一点、标签纹丝不动）。
                                 和 Ctrl+C/V 是同一类问题，处理方式也一样。 -->
                            <KeyboardAccelerator Key="Up" Modifiers="Control"
                                                 Invoked="TagUpAccel_Invoked" />
                            <KeyboardAccelerator Key="Down" Modifiers="Control"
                                                 Invoked="TagDownAccel_Invoked" />
                        </ListView.KeyboardAccelerators>
                        <!-- 分段不用 ListView 的 GroupStyle：WinUI 3 上实测分组头
                             不渲染（CollectionViewSource 确实分好了组，日志能看到
                             groups=4，但 HeaderTemplate 一个都没画出来）。
                             改成把"大类条带"画在每段第一行的行模板里——分段边界
                             由数据自己表达，不依赖控件的分组头实现。 -->
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:TagItem">
                                <StackPanel>
                                    <!-- 大类条带：只有每段第一行可见 -->
                                    <Grid Visibility="{x:Bind HeaderVisibility}"
                                          Background="{x:Bind HeaderBrush}"
                                          BorderThickness="3,0,0,0"
                                          BorderBrush="{x:Bind AccentBrush}"
                                          Padding="6,2" Margin="0,6,0,2"
                                          ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind SectionTitle}" FontSize="11"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind SectionSubtitle}"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>

                                    <!-- 一行标签。左侧竖条与条带同色，把整段连成一个框 -->
                                    <Grid ColumnSpacing="8" Padding="4,1"
                                          Background="{x:Bind RowTint}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3" Background="{x:Bind AccentBrush}"
                                                Margin="-4,0,0,0" />
                                        <StackPanel Grid.Column="1">
                                            <!-- 常态：标签文字 -->
                                            <TextBlock Text="{x:Bind Tag}" FontFamily="Consolas"
                                                       Visibility="{x:Bind DisplayVisibility, Mode=OneWay}" />
                                            <!-- 编辑态：就地改名。Enter 提交、Esc 取消、失焦提交。
                                                 Text 走 OneTime 绑定：输入框的内容归用户所有，
                                                 不能被后台刷新（改色、重建列表）覆盖掉。
                                                 用 AutoSuggestBox 而不是 TextBox：双击进来时
                                                 要能像"添加标签"那样展开候选列表，并且共用
                                                 同一套 Tab 补全（AutoSuggestBox 的候选弹层
                                                 在 Popup 里，不会被列表行的裁剪切掉）。
                                                 Text 默认 OneTime，所以控件不会把用户改的字
                                                 写回 TagItem——它只负责"回车时读一遍"。 -->
                                            <AutoSuggestBox x:Name="TagEditBox" Text="{x:Bind Tag}"
                                                     FontFamily="Consolas" Padding="4,2"
                                                     MaxSuggestionListHeight="240"
                                                     PlaceholderText="标签，中文或英文"
                                                     Visibility="{x:Bind EditVisibility, Mode=OneWay}"
                                                     TextChanged="TagEditBox_TextChanged"
                                                     SuggestionChosen="TagEditBox_SuggestionChosen"
                                                     QuerySubmitted="TagEditBox_QuerySubmitted"
                                                     KeyDown="TagEditBox_KeyDown"
                                                     LostFocus="TagEditBox_LostFocus" />
                                            <TextBlock Text="{x:Bind Note}" FontSize="11"
                                                       Visibility="{x:Bind NoteVisibility}"
                                                       Foreground="{x:Bind NoteBrush}" />
                                        </StackPanel>
                                        <!-- 右栏：中文释义。词库值用灰色；模型补译的用橙色 +
                                             「≈」前缀，并在下一行写明来源——两者可信度不同，
                                             必须在界面上可分，不能混成一个样子。 -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    MaxWidth="200">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Text="{x:Bind CnBadge}" FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{x:Bind CnBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Cn}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{x:Bind CnBrush}"
                                                           ToolTipService.ToolTip="{x:Bind CnNote}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind CnNote}" FontSize="10"
                                                       Visibility="{x:Bind CnNoteVisibility}"
                                                       Foreground="DarkOrange"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- 按钮内边距收窄到 8,4：默认内边距下这一行要 250 DIP，而中栏的
                     最小宽度必须同时小于默认布局的自然宽度（约 251 DIP），
                     否则默认的 2:2:3 自己就会被挤变形。收窄后是 226 DIP，两边都满足。
                     「规整大类顺序」刻意只放在「标签」菜单里（Ctrl+Shift+S）：
                     加到这里会让这一行超出 240 DIP 的下限，默认布局直接被挤变形。 -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                    <Button Content="上移" Click="TagUp_Click" Padding="8,4" />
                    <Button Content="下移" Click="TagDown_Click" Padding="8,4" />
                    <Button Content="删除" Click="TagDelete_Click" Padding="8,4" />
                    <Button Content="校验" Click="TagAudit_Click" Padding="8,4" />
                </StackPanel>
            </Grid>

            <Thumb Grid.Column="3" Style="{StaticResource SplitterThumbStyle}"
                   DragDelta="RightSplitter_DragDelta"
                   DragCompleted="Splitter_DragCompleted"
                   DoubleTapped="RightSplitter_DoubleTapped"
                   ToolTipService.ToolTip="拖动调整宽度，双击恢复默认" />

            <!-- 右：提示词原文 + 翻译器 -->
            <Grid Grid.Column="4" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="160" />
                </Grid.RowDefinitions>

                <!-- 上：写入文件的提示词原文（标签 + 英文自然语言）
                     用 RichEditBox 而不是 TextBox：要把每一段按它所属大类上底色，
                     而 TextBox 没有区间字符格式 API。 -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,0,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                            <Run Text="提示词原文" />
                            <Run Text="（写入 .txt）" FontSize="11"
                                 Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" x:Name="CaptionStatusText" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <RichEditBox x:Name="CaptionBox" TextWrapping="Wrap"
                                     FontFamily="Consolas" BorderThickness="0" Background="Transparent"
                                     IsSpellCheckEnabled="False" AcceptsReturn="False"
                                     TextChanged="CaptionBox_TextChanged"
                                     PlaceholderText="标签 + 英文自然语言；Ctrl+S 写回同名 .txt" />
                    </Border>
                </Grid>

                <!-- 中间：分隔 -->
                <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- 下：翻译器。中文自然语言 → 英文自然语言（Anima 的散文通道）。
                     刻意不产出散装 tag：tag 交给中栏（词库补全 + 大类分段 + 校验），
                     两边各管一件事，不重复。依据是官方模型卡：
                       "You can mix tags and natural language in arbitrary order."
                       "If using pure natural langauge, more descriptive is better.
                        Aim for at least 2 sentences." -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,0,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="中文描述 → 英文自然语言" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" x:Name="VocabStatusText" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <TextBox x:Name="NaturalBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent"
                                 PlaceholderText="中文描述，例如：银发少女在樱花树下侧身站立，穿水手服，微风，逆光，全身构图" />
                    </Border>

                    <Grid Grid.Row="2" Margin="0,6,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 只有一个翻译按钮：这条路必须走模型（词库给的是标签，
                             而这一栏要的是英文散文），所以以前那个「纯词库」按钮
                             和「+ 模型」按钮做的是同一件事，留着是误导。 -->
                        <Button x:Name="TranslateBtn" Content="翻译并追加" Click="Translate_Click" />
                        <CheckBox Grid.Column="1" x:Name="AppendModeBox" Content="替换已有散文"
                                  VerticalAlignment="Center" Click="AppendModeBox_Click"
                                  ToolTipService.ToolTip="默认把译文接到提示词末尾（官方写法：标签 + 句号 + 散文）。勾选则替换已有的那段散文，标签不动。" />
                        <Button Grid.Column="2" x:Name="UndoTranslateBtn" Content="撤销翻译"
                                Click="UndoTranslate_Click" IsEnabled="False" />
                        <ProgressRing Grid.Column="3" x:Name="BusyRing" Width="18" Height="18"
                                      IsActive="False" HorizontalAlignment="Left" />
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="TranslateInfoText" FontSize="11" Margin="2,4,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Grid Grid.Row="2" Padding="12,6,12,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DatasetStatsText" FontSize="11" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Grid.Column="1" x:Name="SelectionText" FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button x:Name="PrevBtn" Content="◀" Click="Prev_Click" ToolTipService.ToolTip="上一张 (Alt+←)" />
                <Button x:Name="NextBtn" Content="▶" Click="Next_Click" ToolTipService.ToolTip="下一张 (Alt+→)" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
