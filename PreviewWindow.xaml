<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AnimaCaptioner.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="预览">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <Grid Grid.Row="0" Padding="12,8,12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="FitBtn" Content="适应窗口" Click="Fit_Click"
                    ToolTipService.ToolTip="整张图放进窗口，窗口大小变化时自动跟随" />
            <Button Grid.Column="1" x:Name="ActualBtn" Content="1:1" Click="Actual_Click"
                    ToolTipService.ToolTip="一个图像像素对应一个屏幕像素（已按系统 DPI 缩放换算）" />
            <Button Grid.Column="2" x:Name="ZoomOutBtn" Content="－" Click="ZoomOut_Click"
                    ToolTipService.ToolTip="缩小 (Ctrl+-)" />
            <Button Grid.Column="3" x:Name="ZoomInBtn" Content="＋" Click="ZoomIn_Click"
                    ToolTipService.ToolTip="放大 (Ctrl+=)" />

            <TextBlock Grid.Column="5" x:Name="NavText" VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4">
                <Button x:Name="PrevBtn" Content="◀" Click="Prev_Click"
                        ToolTipService.ToolTip="上一张 (←)" />
                <Button x:Name="NextBtn" Content="▶" Click="Next_Click"
                        ToolTipService.ToolTip="下一张 (→)" />
            </StackPanel>
        </Grid>

        <!-- 画布。Image 显式设成像素尺寸，ScrollViewer 的 ZoomFactor 才有确定含义：
             zoom=1 即 1 图像像素 = 1 DIP，「适应窗口」和「1:1」才算得出准确倍率。 -->
        <Border Grid.Row="1" Margin="12,0,12,0" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <!-- 不显式设 MinZoomFactor/MaxZoomFactor：超出控件允许范围会让
                     LoadComponent 直接抛 XamlParseException（实测 0.05 就低于下限，
                     整个窗口构造失败）。缩放范围一律在代码里用控件自己的
                     Min/MaxZoomFactor 夹紧，见 SetZoom。 -->
                <ScrollViewer x:Name="Scroll" ZoomMode="Enabled"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                              SizeChanged="Scroll_SizeChanged"
                              ViewChanged="Scroll_ViewChanged">
                    <Image x:Name="PreviewImage" Stretch="Fill" />
                </ScrollViewer>

                <ProgressRing x:Name="Busy" Width="36" Height="36" IsActive="False"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBlock x:Name="Placeholder" Text="没有可预览的图片"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Grid Grid.Row="2" Padding="12,6,12,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="InfoText" FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>
    </Grid>
</Window>
