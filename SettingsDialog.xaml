<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AnimaCaptioner.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="设置"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <!-- 左栏类别 + 右栏设置项。这条布局改了宽度约束：内容区可用宽度 =
         ContentDialogMaxWidth 减去内容区两侧的内边距（实测每侧 26 DIP），默认 548
         时只剩 496，装不下一栏导航。所以这里把上限抬到 880，下面的 SettingsRoot
         才敢写死 800 宽。宽度到底够不够由 ProbeScreenRects 常驻自检——它比宽度
         多就把"右边缘被裁掉"写进日志，不靠肉眼发现。 -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <!-- 高度上限：窗口够高时对话框最多这么高，再高的页面靠内部滚动。窗口不够高时
             由弹出层自己再往下夹，不用我们操心。 -->
        <x:Double x:Key="ContentDialogMaxHeight">640</x:Double>
    </ContentDialog.Resources>

    <!-- 宽度与高度都由 code-behind 的 FitToDialog 钉成固定值，**这里不写死任何一个**。
         两边都写死会互相打架（实测过：XAML 写 520 高而对话框只给得起约 415，超出的部分
         既不滚动也不报错，直接看不见——联网搜索页「回灌条数」的下半截和「测试搜索」
         按钮就是这样点不到的）。MaxWidth 留在这里只当兜底。
         MinWidth 刻意不写：窄窗口里要让出去，写死 748 会让对话框比窗口还宽。 -->
    <Grid x:Name="SettingsRoot" MaxWidth="800" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 类别用 ListView 而不是 NavigationView：后者在对话框里自带汉堡按钮、
             默认面板宽 320 DIP，要收窄它得跟它的模板较劲，而这里需要的只是
             "点一下换一页"。 -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="4">
            <ListView x:Name="PageList" SelectionMode="Single"
                      SelectionChanged="PageList_SelectionChanged"
                      Background="Transparent">
                <!-- 每项的 Tag 就是页面的键，和 code-behind 里 _pages 的键一一对应。
                     键对不上会被 MapPages 的自检抓出来写进日志。 -->
                <ListViewItem Tag="model" AutomationProperties.Name="模型接口">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE753;" FontSize="14" />
                        <TextBlock Text="模型接口" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="effort" AutomationProperties.Name="推理参数">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE945;" FontSize="14" />
                        <TextBlock Text="推理参数" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="agent" AutomationProperties.Name="AI 助手">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE99A;" FontSize="14" />
                        <TextBlock Text="AI 助手" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="tools" AutomationProperties.Name="助手工具">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE90F;" FontSize="14" />
                        <TextBlock Text="助手工具" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="search" AutomationProperties.Name="联网搜索">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE774;" FontSize="14" />
                        <TextBlock Text="联网搜索" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="paths" AutomationProperties.Name="数据路径">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="数据路径" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="vocab" AutomationProperties.Name="词库构建">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                        <TextBlock Text="词库构建" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="edit" AutomationProperties.Name="编辑">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        <TextBlock Text="编辑" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="colors" AutomationProperties.Name="标签大类配色">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE790;" FontSize="14" />
                        <TextBlock Text="标签大类配色" />
                    </StackPanel>
                </ListViewItem>
            </ListView>
        </Border>

        <!-- 右栏。七页都常驻在这棵树里，切换只翻 Visibility——**不是**重建。
             这样各页控件的值在切来切去之间不会丢（ApplyTo 读的是同一批命名控件）。
             PageHost 的每个子元素都必须是某一页，MapPages 会自检。

             **PageHost 必须是 StackPanel，不能是 Grid**：Grid 的单行是 `*` 行，而星号行
             会把自身高度钳到可用高度，于是父滚动器永远看不到"内容比视口高"——超出的
             部分既不滚动也不报错，直接裁掉（实测联网搜索页「回灌条数」的下半截和
             「测试搜索」按钮就这样点不到，而 extent 还报成和视口一样高）。
             StackPanel 即使在有限高度下被测量，也按子元素自然高度求和上报。 -->
        <ScrollViewer x:Name="ContentScroll" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="PageHost">

                <!-- ============ 模型接口 ============ -->
                <StackPanel x:Name="PageModel" Spacing="10">
                    <TextBlock Text="模型站点" FontWeight="SemiBold" />
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="每个站点记住一整套「地址 + 密钥 + 模型名 + 推理档位」。换服务时点一下就行，不用改四处——本地 llama-server 和云端这些值全都不一样，档位甚至是相反的。" />

                    <!-- 站点列表。行由代码生成（见 BuildProfileRows）：行数随配置变，
                         写死在 XAML 里就得维护两处。高度封顶，站点多了自己滚动，
                         免得把下面的编辑器顶出视野（那正是"设置项够不到"的老问题）。 -->
                    <Border CornerRadius="6" BorderThickness="1" Padding="2"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ListView x:Name="ProfileList" SelectionMode="Single" MaxHeight="150"
                                  SelectionChanged="ProfileList_SelectionChanged"
                                  Background="Transparent" />
                    </Border>

                    <Button x:Name="AddProfileBtn" Content="＋ 添加站点" Click="AddProfile_Click" />

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- 选中站点的编辑器。和列表常驻在同一页（不是弹出层）：
                         ContentDialog 里再套一个 ContentDialog 在 WinUI 上不可靠，
                         而内联展开只需滚动就能看全。 -->
                    <StackPanel x:Name="ProfileEditor" Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EditorTitleText" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Text="编辑站点" />
                            <!-- 删除是摧毁性的、又紧挨着别的按钮，所以单独放右侧、
                                 并且只在还有第二个站点时可点（最后一个不允许删）。 -->
                            <Button Grid.Column="1" x:Name="DeleteProfileBtn" Content="删除此站点"
                                    Padding="8,4" Click="DeleteProfile_Click" />
                        </Grid>

                        <TextBox x:Name="ProfileNameBox" Header="显示名（留空则用主机名）" />
                        <TextBox x:Name="BaseUrlBox" Header="接口地址（base url，含 /v1）"
                                 PlaceholderText="http://127.0.0.1:8080/v1" />

                        <!-- 模型名做成可输入的下拉框：能列出服务端给的模型，也允许直接键入
                             列表里没有的名字（别名、自定义名，或压根不实现 /models 的网关）。 -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--
                              刻意**不设** PlaceholderText：可编辑 ComboBox 上它会盖过真实文本，
                              实测填着 deepseek-v4-pro 时框里显示的是占位符（灰字），看起来像
                              "模型名没读进来"。空着的时候下面那行提示已经说清了可以手填。
                            -->
                            <ComboBox x:Name="ModelBox" Header="模型名" IsEditable="True"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="Model_SelectionChanged" />
                            <Button Grid.Column="1" x:Name="FetchModelsBtn" Content="获取列表"
                                    Click="FetchModels_Click" VerticalAlignment="Bottom" />
                        </Grid>

                        <TextBlock x:Name="ModelListText" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <PasswordBox x:Name="ApiKeyBox" Header="API Key"
                                     PasswordChanged="ApiKeyBox_PasswordChanged"
                                     PlaceholderText="留空则保持已有密钥不变" />

                        <TextBlock x:Name="KeyHintText" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="留空表示不发送 Authorization 头（本地 llama-server 不需要）。密钥用 Windows DPAPI 加密后存放，仅限本机本账户可解密。" />

                        <!-- 额外请求头。多数平台不需要，但有的网关不认自己的头就不服务
                             （实测 OpenCode 的 Go 档要求 x-opencode-session）。 -->
                        <TextBox x:Name="CustomHeadersBox" Header="额外请求头（每行一个，可留空）"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                 PlaceholderText="x-opencode-session: ses_xxxx"
                                 TextChanged="CustomHeadersBox_TextChanged" />
                        <TextBlock x:Name="CustomHeadersHintText" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <!-- 推理档位跟着站点走：本地 llama-server 只认「关闭思考」那一档，
                             云端认 8 档强度，两者要的取值正好相反。 -->
                        <ComboBox x:Name="ReasoningBox" Header="推理档位（reasoning_effort）"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Reasoning_SelectionChanged"
                                  ToolTipService.ToolTip="混合推理模型会先输出思考过程，这个档位就是让它想多久。散文翻译「关闭思考」与非 none 档位实测质量相同（各 3 次采样共 12 个样本全干净），只是思考越久越慢——开思考时程序会自动多留 token 预算，思考内容也永远不会写进译文。两种服务端要用两种关法，程序按服务端在 /models 里报的能力自动选：本地 llama-server 用 enable_thinking=false（只认「关闭思考」这一档），云端用 reasoning_effort。" />
                        <TextBlock x:Name="EffortHintText" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <Grid x:Name="ApiRowGrid" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TestResultText" FontSize="11"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Grid.Column="1" x:Name="TestBtn" Content="测试连接" Click="Test_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- ============ 推理参数 ============ -->
                <StackPanel x:Name="PageEffort" Spacing="10">
                    <TextBlock Text="推理与生成参数" FontWeight="SemiBold" />

                    <!-- 推理档位不在这里：它已经是**站点**的一个属性（本地 llama-server
                         只认「关闭思考」，云端认 8 档强度，两者要的取值相反），
                         所以挪到「模型接口」页跟着站点一起编辑。 -->
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="推理档位跟着站点走，在「模型接口」页里选定。下面这三项对所有站点共用。" />

                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="本地模型首次请求要编译 GPU kernel，可能明显偏慢；超时设大一些更稳妥。" />

                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="下面这组是**翻译与短任务**用的（标签释义、中译英散文、问模型找标签）：一句进一句出，400 就够，放大没有收益。AI 助手有自己的一组，在「AI 助手」页里。" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="MaxTokensBox" Header="max_tokens（翻译）" Minimum="32" Maximum="1048576"
                                   SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="1" x:Name="TempBox" Header="temperature" Minimum="0" Maximum="2"
                                   SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="2" x:Name="TimeoutBox" Header="超时（秒）" Minimum="10" Maximum="3600"
                                   SpinButtonPlacementMode="Compact" />
                    </Grid>

                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="上限放到 1048576 是按服务端可能声明的最大输出（实测 DeepSeek 报 393216）。翻译那条路不建议调大。" />
                </StackPanel>

                <!-- ============ AI 助手 ============ -->
                <StackPanel x:Name="PageAgent" Spacing="10">
                    <TextBlock Text="AI 助手" FontWeight="SemiBold" />

                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="打开后，右栏下半部分从「中文描述 → 英文自然语言」换成对话面板：能读当前图片、能查词库，并提出一组标签和一段散文——但要你点「应用」才写进提示词。关掉时仍是原来的确定性翻译器（那条路的长度跟着输入走，不会自己加质量词）。" />

                    <CheckBox x:Name="AgentEnabledBox" Content="打开 AI 助手面板"
                              Click="AgentEnabledBox_Click"
                              ToolTipService.ToolTip="把右栏下半部分从「中文描述 → 英文自然语言」换成对话面板：能读当前图片、能查词库，并提出一组标签和一段散文——但要你点「应用」才写进提示词。关掉时仍是原来的确定性翻译器。" />
                    <CheckBox x:Name="AgentAttachImageBox" Content="标注模式下把当前图片发给模型"
                              ToolTipService.ToolTip="读图自动打标靠这一条。图片先缩到长边 1024 的 JPEG 再内联发送（约 150 KB）；原图不会上传到任何别的地方，但请确认接口地址是你信任的服务。接口或模型不支持图片输入时会如实报错，不会静默退回凭空描述。" />

                    <NumberBox x:Name="AgentRoundsBox" Header="工具调用轮数上限（每轮一次请求）"
                               Minimum="1" Maximum="200" SmallChange="4"
                               SpinButtonPlacementMode="Compact" Width="240"
                               HorizontalAlignment="Left" />
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="一轮 = 一次请求，一轮里模型可以同时发多个工具调用。给得大，复杂问题能查得透；每次请求十几秒，用光了就是可能的等待更久。默认 32。" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 0 = 自动。**默认就是 0**，因为写死一个数永远是猜：
                             服务端自己报的出/上下文上限才是依据（见设置页那行提示）。 -->
                        <NumberBox x:Name="AgentMaxTokensBox" Header="max_tokens（0 = 自动）"
                                   Minimum="0" Maximum="1048576" SmallChange="1024"
                                   SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="1" x:Name="AgentTempBox" Header="temperature"
                                   Minimum="0" Maximum="2" SmallChange="0.1"
                                   SpinButtonPlacementMode="Compact" />
                    </Grid>
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="助手每一轮的额度单独设：一轮里可能带图（约 850 token）、带整份对话历史，还要先写几百 token 的思考链再发工具调用——实测复杂打标会把原来写死的 2400 用光。填 0 = 自动：按服务端 /models 报的输出上限算（没报就按上下文的一半），本机不联网时兜底 16384。" />

                    <!-- 完全权限。刻意排在最后、并单独给一段说明：它推翻的是
                         "助手只出提案、落盘由人点一下"这条原则，不该被顺手勾上。 -->
                    <CheckBox x:Name="AgentFullAccessBox" Content="完全权限：助手直接写入提示词，不等我确认"
                              ToolTipService.ToolTip="打开后，助手提出的标签和散文会立刻写进当前提示词，不再显示「应用」按钮。写入仍然只算一个撤销点，Ctrl+Z 可以整体撤销。" />
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="⚠ 完全权限让渡的是「模型改了训练集而你没看见」这条保证：从打开那一刻起，助手想改就改，不问。它仍然只算一个撤销点（Ctrl+Z 能全退），每次写入也都会记进日志。建议只在你盯着屏幕、且信任当前模型与接口时打开。" />
                </StackPanel>

                <!-- ============ 助手工具 ============ -->
                <!-- 行是**代码生成**的（AgentKit.ToolCatalog 是唯一来源）：
                     十二个工具逐个写 XAML 的话，将来加一个工具就会漏写一行，
                     而漏写的表现是"这个工具永远关不掉"——界面上看不出来。 -->
                <StackPanel x:Name="PageTools" Spacing="10">
                    <TextBlock Text="助手能用哪些工具" FontWeight="SemiBold" />
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="关掉的工具不会下发给模型，它也就不会去调用——系统提示里同样不会提到。这一页只决定「允不允许」；某些工具还需要前提条件（比如完全权限、打开数据集、启用搜索），前提没满足时即使勾着也不会生效，行末会写出来。" />
                    <StackPanel x:Name="ToolRows" Spacing="2" />
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="关掉「提出改动」之后助手就只能回答问题、改不了提示词——除非你确实只想拿它当顾问，否则别关。" />
                </StackPanel>

                <!-- ============ 联网搜索 ============ -->
                <StackPanel x:Name="PageSearch" Spacing="10">
                    <TextBlock Text="联网搜索（模型可调用的工具）" FontWeight="SemiBold" />
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="给模型一个 web_search 工具：遇到不认识或没有官方中文释义的标签时，它可以自己决定去查一下。默认指向 192.168.1.4 上已部署的搜索网关。" />

                    <CheckBox x:Name="SearchEnabledBox" Content="启用搜索工具"
                              ToolTipService.ToolTip="实测：推理档位设为「关闭思考」时模型不会调用搜索工具，所以启用搜索需要同时选一个会思考的档位（或「自动」）。" />

                    <ComboBox x:Name="ProviderBox" Header="搜索后端" HorizontalAlignment="Stretch"
                              SelectionChanged="Provider_SelectionChanged">
                        <ComboBoxItem Content="局域网搜索网关（Anthropic 兼容，推荐）" Tag="shim" />
                        <ComboBoxItem Content="SearXNG 实例（直连 JSON 接口）" Tag="searxng" />
                        <ComboBoxItem Content="Tavily API" Tag="tavily" />
                        <ComboBoxItem Content="Brave Search API" Tag="brave" />
                        <ComboBoxItem Content="Serper.dev（Google 结果）" Tag="serper" />
                    </ComboBox>

                    <TextBox x:Name="SearchUrlBox" Header="搜索接口地址" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchSniBox" Header="TLS SNI / Host（Caddy 网关必填）" />
                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Bottom" Margin="6,0,0,6"
                                   MaxWidth="140" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="填证书域名，不是 IP" />
                    </Grid>

                    <PasswordBox x:Name="SearchKeyBox" Header="搜索 API Key"
                                 PlaceholderText="局域网网关 / 自建 SearXNG 可留空" />

                    <TextBlock x:Name="SearchHintText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="SearchMaxBox" Header="回灌条数" Minimum="1" Maximum="20"
                                   SpinButtonPlacementMode="Compact" Width="110" />
                        <TextBlock Grid.Column="1" x:Name="SearchTestText" FontSize="11" Margin="10,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="2" x:Name="SearchTestBtn" Content="测试搜索"
                                Click="TestSearch_Click" VerticalAlignment="Bottom" />
                    </Grid>
                </StackPanel>

                <!-- ============ 数据路径 ============ -->
                <StackPanel x:Name="PagePaths" Spacing="10">
                    <TextBlock Text="数据路径" FontWeight="SemiBold" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DatasetBox" Header="训练集目录" />
                        <Button Grid.Column="1" Content="浏览…" Click="BrowseDataset_Click"
                                VerticalAlignment="Bottom" />
                    </Grid>

                    <TextBox x:Name="VocabBox" Header="词库数据库 (vocab.sqlite)" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SeedBox" Header="人工整理映射 (seed.json)" />
                        <Button Grid.Column="1" Content="浏览…" Click="BrowseSeed_Click"
                                VerticalAlignment="Bottom" />
                    </Grid>

                    <TextBlock x:Name="SettingsPathText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <!-- ============ 词库构建 ============ -->
                <!-- 单独一页，是因为这是唯一一个"要跑几十秒、还会联网下载几百 MB"的设置项。
                     把它塞进「数据路径」会和几个纯文本框混在一起，看不出它是个动作。 -->
                <StackPanel x:Name="PageVocab" Spacing="10">
                    <TextBlock Text="词库构建" FontWeight="SemiBold" />
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="Anima 官方没有发布标签表，模型卡只规定规则（下划线换成空格、画师加 @、score_* 例外），不给名单。所以词库是从几个上游仓库合并构建出来的——本程序不随附成品词库，装完之后在这里建一次即可。" />

                    <TextBlock Text="1. 素材来源" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="每个来源的许可不同，再分发构建产物前请逐个确认。点「下载素材」会按列表顺序抓取（需能访问 raw.githubusercontent.com；国内网络可能需要代理）。" />

                    <!-- 素材清单由代码生成：文件名/来源/许可写在 Core/VocabSources.cs 一处，
                         和构建器、README 共用，避免三处各说一套。 -->
                    <Border CornerRadius="6" BorderThickness="1" Padding="2"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel x:Name="VocabSourceList" Spacing="0" />
                    </Border>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="VocabSourceDirBox" Header="素材目录（放上游文件的文件夹）"
                                 TextChanged="VocabSourceDir_Changed" />
                        <Button Grid.Column="1" Content="浏览…" Click="BrowseVocabSources_Click"
                                VerticalAlignment="Bottom" />
                        <Button Grid.Column="2" x:Name="DownloadVocabBtn" Content="下载素材"
                                Click="DownloadVocab_Click" VerticalAlignment="Bottom" />
                    </Grid>

                    <TextBlock x:Name="VocabMissingText" FontSize="11" TextWrapping="Wrap" />

                    <TextBox x:Name="VocabProxyBox"
                             Header="下载代理（留空 = 直连；国内网络通常要填）"
                             PlaceholderText="http://127.0.0.1:10808" />
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="上游在 raw.githubusercontent.com 与 danbooru.donmai.us，国内直连会超时。系统代理不会被自动采用（实测本机系统代理返回直连、而直连不通），所以要显式填。只影响「下载素材」，不影响其它功能。" />

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock Text="2. 构建" FontWeight="SemiBold" />
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="构建会覆盖现有的词库文件，并在同目录写入 seed.json（人工整理的中文映射；已存在则不覆盖）。整个过程约两三分钟，期间界面可以继续用。" />

                    <TextBox x:Name="VocabOutBox" Header="输出位置 (vocab.sqlite)" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="VocabProgress" Minimum="0" Maximum="100"
                                     VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="BuildVocabBtn" Content="开始构建"
                                Click="BuildVocab_Click" />
                    </Grid>

                    <TextBlock x:Name="VocabStatusText" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>

                <!-- ============ 编辑 ============ -->
                <StackPanel x:Name="PageEdit" Spacing="10">
                    <TextBlock Text="编辑" FontWeight="SemiBold" />

                    <NumberBox x:Name="UndoStepsBox" Header="最大撤销步数（0 = 关闭撤销）"
                               Minimum="0" Maximum="1000" SmallChange="10"
                               SpinButtonPlacementMode="Compact" Width="240" HorizontalAlignment="Left" />

                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="撤销覆盖标签和自然语言的改动：添加、删除、移动、改名、粘贴、规范化、重排、翻译、清空。Ctrl+Z 撤销、Ctrl+Y 重做，焦点在标签列表里时生效（提示词框里是它自己的撤销，两者不冲突）。撤销只改内存，不写文件——要落盘仍需保存。历史按图片（或草稿）分别记账，来回翻图片不会把撤销记录弄丢；同一份文档离开时被外部改过，那一份的历史会作废。本步数按每份文档计算。" />
                </StackPanel>

                <!-- ============ 标签大类配色 ============ -->
                <StackPanel x:Name="PageColors" Spacing="10">
                    <TextBlock Text="标签大类配色" FontWeight="SemiBold" />
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="中间 tag 列表按 Anima 官方大类分段显示，每段用这里的颜色画框。点色块打开取色器。" />

                    <Grid x:Name="ColorGrid" ColumnSpacing="8" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 九个大类 + 自然语言的行由代码生成：写死在 XAML 里的话，
                             TagSections.Colorable 一改就两边不同步了。
                             取色器放在弹出层里而不是直接铺在页面上——十个 ColorPicker
                             平铺会把对话框撑到屏幕外，底部的保存按钮都够不到。 -->
                    </Grid>

                    <Button x:Name="ResetColorsBtn" Content="恢复默认配色" Click="ResetColors_Click" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
