<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 与应用同一个 TFM 代际（应用是 net10.0-windows10.0.19041.0）。
         刻意不带 -windows 后缀：这里编译的 Core 源码是纯 .NET，唯一的平台相关点
         DpapiSecret 走 P/Invoke 而不是 Windows 专用 API 包。 -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- 声明成 x64，与应用的 <Platforms>x64</Platforms> 对齐：
         两套平台不一致时 VS 会报「解决方案包含未知的项目配置映射」。 -->
    <Platforms>x64</Platforms>
    <!-- 与应用同款处理：不让输出路径多出一层 x64\，保持 tests\bin\Release\net10.0
         （README 里的测试命令都是这个路径）。 -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>AnimaCaptioner</RootNamespace>
    <AssemblyName>corecheck</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 与应用同版本，避免"测试跑过的代码路径和应用实际跑的不是同一套托管依赖"。
         先前这里是 8.0.10：那时测试是 net8.0，跨代际只能用 8.x。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!--
      直接编译 app 的真实源文件（不是副本），所以归类规则、提示词解析、写盘逻辑
      一改就会被测到。用相对路径定位，clone 到任何地方都能构建。
    -->
    <Compile Include="..\Log.cs" />
    <Compile Include="..\Core\VocabDb.cs" />
    <Compile Include="..\Core\CaptionFile.cs" />
    <Compile Include="..\Core\AppSettings.cs" />
    <Compile Include="..\Core\LlmClient.cs" />
    <Compile Include="..\Core\DpapiSecret.cs" />
    <Compile Include="..\Core\Parity.cs" />
    <Compile Include="..\Core\TagSections.cs" />
    <Compile Include="..\Core\TagOrder.cs" />
    <Compile Include="..\Core\PromptText.cs" />
    <Compile Include="..\Core\TagEscape.cs" />
    <Compile Include="..\Core\TagEdit.cs" />
    <Compile Include="..\Core\TagComplete.cs" />
    <Compile Include="..\Core\TagSearch.cs" />
    <Compile Include="..\Core\TagSearchAgent.cs" />
    <Compile Include="..\Core\SafetyRating.cs" />
    <Compile Include="..\Core\PromptDoc.cs" />
    <Compile Include="..\Core\PromptLibraryStore.cs" />
    <Compile Include="..\Core\PromptHistory.cs" />
    <Compile Include="..\Core\PromptHistoryStore.cs" />
    <Compile Include="..\Core\AgentKit.cs" />
    <Compile Include="..\Core\TagAgent.cs" />
    <Compile Include="..\Core\ImageSizing.cs" />
    <Compile Include="Sections.cs" />
    <Compile Include="RoundTrip.cs" />
    <Compile Include="Prose.cs" />
    <Compile Include="Edit.cs" />
    <Compile Include="Complete.cs" />
    <Compile Include="Search.cs" />
    <Compile Include="Safety.cs" />
    <Compile Include="Prompts.cs" />
    <Compile Include="History.cs" />
    <Compile Include="Escape.cs" />
    <Compile Include="Defaults.cs" />
    <Compile Include="Models.cs" />
    <Compile Include="Agent.cs" />
    <Compile Include="Reasoning.cs" />
    <Compile Include="RichApi.cs" />
    <Compile Include="LlmLive.cs" />
    <Compile Include="Harness.cs" />
  </ItemGroup>
</Project>
